{
  "type": "panel",
  "i18n": true,
  "items": {
    "lifx_interval": {
      "type": "number",
      "label": {
        "en": "Local device polling interval (seconds)",
        "de": "Abfrageintervall lokaler Geräte (Sekunden)"
      },
      "min": 5,
      "max": 3600,
      "default": 30
    },
    "diagnosticsEnabled": {
      "type": "checkbox",
      "label": {
        "en": "Collect Wi-Fi and firmware diagnostics",
        "de": "WLAN- und Firmware-Diagnosewerte erfassen"
      },
      "default": true
    },
    "diagnosticsInterval": {
      "type": "number",
      "label": {
        "en": "Diagnostics interval (seconds)",
        "de": "Diagnoseintervall (Sekunden)"
      },
      "min": 30,
      "max": 86400,
      "default": 300
    },
    "cloudEnabled": {
      "type": "checkbox",
      "label": {
        "en": "Enable optional LIFX Cloud integration",
        "de": "Optionale LIFX-Cloud-Integration aktivieren"
      },
      "default": false
    },
    "cloudToken": {
      "type": "password",
      "encrypted": true,
      "label": {
        "en": "LIFX Cloud API token",
        "de": "LIFX-Cloud-API-Token"
      },
      "default": ""
    },
    "cloudPollInterval": {
      "type": "number",
      "label": {
        "en": "Cloud synchronization interval (seconds)",
        "de": "Cloud-Synchronisierungsintervall (Sekunden)"
      },
      "min": 60,
      "max": 86400,
      "default": 300
    },
    "syncGroups": {
      "type": "checkbox",
      "label": {
        "en": "Synchronize groups",
        "de": "Gruppen synchronisieren"
      },
      "default": true
    },
    "syncLocations": {
      "type": "checkbox",
      "label": {
        "en": "Synchronize locations",
        "de": "Standorte synchronisieren"
      },
      "default": true
    },
    "syncScenes": {
      "type": "checkbox",
      "label": {
        "en": "Synchronize scenes and create activation controls",
        "de": "Szenen synchronisieren und Aktivierungsschalter anlegen"
      },
      "default": true
    },
    "effectPeriod": {
      "type": "number",
      "label": {
        "en": "Breathe and pulse period (milliseconds)",
        "de": "Dauer eines Atem- oder Pulszyklus (Millisekunden)"
      },
      "min": 100,
      "max": 10000,
      "default": 1000
    },
    "effectCycles": {
      "type": "number",
      "label": {
        "en": "Breathe and pulse cycles",
        "de": "Anzahl der Atem- oder Pulszyklen"
      },
      "min": 1,
      "max": 100,
      "default": 10
    },
    "effectHue": {
      "type": "number",
      "label": {
        "en": "Effect color hue (0–360°)",
        "de": "Farbton für Effekte (0–360°)"
      },
      "min": 0,
      "max": 360,
      "default": 180
    },
    "effectSaturation": {
      "type": "number",
      "label": {
        "en": "Effect color saturation (%)",
        "de": "Farbsättigung für Effekte (%)"
      },
      "min": 0,
      "max": 100,
      "default": 100
    },
    "effectBrightness": {
      "type": "number",
      "label": {
        "en": "Effect brightness (%)",
        "de": "Helligkeit für Effekte (%)"
      },
      "min": 1,
      "max": 100,
      "default": 100
    },
    "effectKelvin": {
      "type": "number",
      "label": {
        "en": "Effect color temperature (Kelvin)",
        "de": "Farbtemperatur für Effekte (Kelvin)"
      },
      "min": 2500,
      "max": 9000,
      "default": 3500
    },
    "effectPulseDuty": {
      "type": "number",
      "label": {
        "en": "Pulse color duty cycle (0–1)",
        "de": "Puls-Farbanteil (0–1)"
      },
      "min": 0,
      "max": 1,
      "default": 0.5
    },
    "effectColorLoopInterval": {
      "type": "number",
      "label": {
        "en": "Color Loop step interval (milliseconds)",
        "de": "Farbwechselintervall (Millisekunden)"
      },
      "min": 250,
      "max": 60000,
      "default": 3000
    },
    "multiZoneMoveSpeed": {
      "type": "number",
      "label": {
        "en": "Lightstrip Move cycle (milliseconds)",
        "de": "Zyklusdauer für Move am Lightstrip (Millisekunden)"
      },
      "min": 100,
      "max": 60000,
      "default": 1500
    },
    "multiZoneMoveAway": {
      "type": "checkbox",
      "label": {
        "en": "Move away from zone 0",
        "de": "Move von Zone 0 weg bewegen"
      },
      "default": false
    }
  }
}
