{
  "name": "iobroker.lifx-smart-lighting",
  "version": "0.1.0",
  "description": "ioBroker adapter for LIFX smart lighting",
  "author": {
    "name": "SvenM74"
  },
  "homepage": "https://github.com/svenm74/iobroker.lifx-smart-lighting",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "light",
    "lifx"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/svenm74/iobroker.lifx-smart-lighting.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "lifx-lan-client": "^2.1.2"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.2.1",
    "@types/node": "^25.9.6",
    "@types/proxyquire": "^1.3.31",
    "proxyquire": "^2.1.3",
    "typescript": "~6.0.3"
  },
  "bugs": {
    "url": "https://github.com/svenm74/iobroker.lifx-smart-lighting/issues"
  },
  "main": "main.js",
  "readmeFilename": "README.md",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*).json",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "lib/",
    "io-package.json",
    "LICENSE",
    "main.js"
  ],
  "scripts": {
    "test:js": "node --check main.js && node --test test/adapter.test.js test/tile-effects.test.js test/admin-config.test.js",
    "test:package": "node --test test/package-files.test.js",
    "test:unit": "node --test test/adapter.test.js",
    "test": "npm run test:js && npm run test:package",
    "check": "npm test",
    "translate": "translate-adapter",
    "release": "release-script"
  }
}
